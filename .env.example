# =================================
# ENGUNITY AI - OPTIMIZED ENVIRONMENT CONFIGURATION
# =================================
# This template includes all optimization variables for memory efficiency
# Copy to .env and replace placeholder values with your actual configuration

# =================================
# PERFORMANCE OPTIMIZATION SETTINGS
# =================================

# Thread Limiting (reduces RAM usage and CPU contention)
# Set to 1 for minimal memory footprint, increase for multi-core performance
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1
TORCH_NUM_THREADS=1

# PyTorch Memory Management
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:64

# Node.js Memory Management (for frontend builds)
# Set to 2048 for 2GB limit, increase if needed but cap to avoid OOM
NODE_OPTIONS=--max-old-space-size=2048

# Model Preloading (disable for lazy loading to save startup memory)
ENABLE_PRELOAD=false

# =================================
# AI Model Configuration
# =================================

# Embedding Model (BGE-small for optimized memory/speed tradeoff)
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DEVICE=cpu
EMBEDDING_MODEL_PATH=backend/models/production/cs_document_embeddings

# LLM Configuration
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=your_groq_api_key_here

# Reranking Model
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Local Model (optional, uses more RAM)
PHI2_MODEL=microsoft/phi-2

# =================================
# FAISS Vector Store Configuration
# =================================

# Model storage paths (use relative or env-based paths, not absolute)
FAISS_INDEX_PATH=/data/faiss/index.faiss
FAISS_META_PATH=/data/faiss/meta.pkl
CITATION_MODEL_PATH=/models/citation_classifier

# =================================
# Database Configuration - MongoDB
# =================================

# MongoDB URI with optimized connection parameters
# Connection pooling, compression, and timeouts are automatically added by the app
MONGODB_URI=mongodb://localhost:27017/engunity-ai
MONGODB_ATLAS_URI=mongodb+srv://username:password@cluster.mongodb.net/engunity-ai
MONGODB_DB_NAME=engunity-ai

# MongoDB connection is auto-optimized with:
# - maxPoolSize=50 (connection pooling)
# - minPoolSize=5 (keep-alive connections)
# - serverSelectionTimeoutMS=5000
# - connectTimeoutMS=3000
# - socketTimeoutMS=10000
# - retryWrites=true
# - w=majority
# Note: Compression disabled (requires optional snappy/zstd npm packages)

# Legacy aliases (for compatibility)
MONGODB_CONNECTION_STRING=mongodb://localhost:27017/engunity-ai
MONGO_URI=mongodb://localhost:27017/engunity-ai

# =================================
# Supabase Configuration (Legacy - Optional)
# =================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_URL=https://your-project.supabase.co

# Supabase S3-Compatible Storage (Legacy - Optional)
SUPABASE_S3_ACCESS_KEY_ID=your_s3_access_key_id
SUPABASE_S3_SECRET_ACCESS_KEY=your_s3_secret_access_key
SUPABASE_S3_ENDPOINT=https://your-project.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=us-east-1

# PostgreSQL (Legacy - Optional)
DATABASE_URL=postgresql://postgres:password@localhost:5432/engunity

# =================================
# AI & ML Services API Keys
# =================================
NEXT_PUBLIC_GROQ_API_KEY=your_groq_api_key_here
NEXT_PUBLIC_OPENAI_API_KEY=your_openai_api_key_here
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# =================================
# Backend API Configuration
# =================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_VERSION=v1
BACKEND_URL=http://localhost:8000
RAG_API_BASE=http://localhost:8000
RAG_BACKEND_URL=http://localhost:8000
API_KEY=your_internal_api_key_here

# =================================
# Authentication & Security
# =================================
NEXTAUTH_SECRET=your_nextauth_secret_here_minimum_32_chars
NEXTAUTH_URL=http://localhost:3000
JWT_SECRET=your_jwt_secret_here_minimum_32_chars_change_in_production

# =================================
# Development & Testing
# =================================
NODE_ENV=development
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_DEBUG_MODE=true

# =================================
# Feature Flags
# =================================
NEXT_PUBLIC_ENABLE_BLOCKCHAIN=false
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_CHAT_HISTORY=true
NEXT_PUBLIC_ENABLE_FILE_UPLOAD=true

# =================================
# Redis Configuration (Optional - for caching)
# =================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# =================================
# Uvicorn/FastAPI Server Configuration
# =================================
WEB_CONCURRENCY=1
UVICORN_WORKERS=1
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000

# =================================
# OPTIMIZATION NOTES
# =================================
#
# Memory Optimization Strategy:
# 1. Thread limiting (OMP/MKL/TORCH) reduces parallel overhead
# 2. MongoDB pooling reuses connections efficiently
# 3. Lazy model loading (ENABLE_PRELOAD=false) saves startup memory
# 4. BGE-small embedding model (384-dim vs 768-dim) uses 70% less RAM
# 5. External LLM (Groq) avoids loading local models (saves 3-4GB)
# 6. Response caching reduces repeated computation
# 7. GZip compression reduces network bandwidth
# 8. Connection pooling and compression for MongoDB
#
# For Production:
# - Increase thread counts based on available cores (OMP_NUM_THREADS=4)
# - Increase MongoDB pool sizes if handling high concurrent requests
# - Enable Redis for distributed caching
# - Set WEB_CONCURRENCY based on CPU cores
# - Use HTTPS and secure secrets
# - Enable production logging and monitoring
#
