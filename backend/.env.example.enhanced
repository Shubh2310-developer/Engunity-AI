# Enhanced Environment Configuration for Real User Data
# Copy this to .env and fill in your actual values

# ========================================
# AUTHENTICATION & USERS
# ========================================

# Supabase Configuration (Real Authentication)
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Mock Authentication (Development Only)
# Set to "true" to use mock users instead of real Supabase auth
USE_MOCK_AUTH=false

# Mock Data Fallback
# Set to "true" to fallback to mock data when real data is unavailable
USE_MOCK_FALLBACK=true

# ========================================
# DATABASE CONFIGURATION
# ========================================

# MongoDB (Primary Database for User Data)
MONGODB_URI=mongodb://localhost:27017/
DATABASE_NAME=engunity-ai

# Connection pool optimization
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5
MONGODB_SERVER_SELECTION_TIMEOUT=5000

# ========================================
# AI SERVICES
# ========================================

# Groq API for LLM Features
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API (Optional - for advanced features)
OPENAI_API_KEY=your_openai_api_key_here

# ========================================
# DOCUMENT PROCESSING
# ========================================

# File Upload Limits
MAX_FILE_SIZE=50MB
MAX_FILES_PER_USER=1000

# Document Processing
ENABLE_OCR=true
ENABLE_VISUAL_ANALYSIS=false
ENABLE_ENTITY_EXTRACTION=true

# ========================================
# FEATURES FROM RESEARCH DOCUMENT
# ========================================

# Intelligent Summarization
ENABLE_SUMMARIZATION=true
SUMMARIZATION_MODEL=llama-3.3-70b-versatile

# Document Analytics
ENABLE_ANALYTICS=true
ANALYTICS_RETENTION_DAYS=365

# Multi-Document Synthesis
ENABLE_MULTI_DOC_SYNTHESIS=true
MAX_DOCUMENTS_PER_SYNTHESIS=20

# Visual Document Analysis (Requires GPT-4V or Claude Vision)
ENABLE_VISUAL_ANALYSIS=false
VISION_MODEL=gpt-4-vision-preview

# Entity Extraction
ENABLE_ENTITY_EXTRACTION=true
ENTITY_MODEL=spacy_en_core_web_lg

# Collaboration Features
ENABLE_COLLABORATION=true
ENABLE_REAL_TIME_ANNOTATIONS=true

# Template System
ENABLE_TEMPLATES=true
TEMPLATE_LIBRARY_SIZE=50

# ========================================
# PERFORMANCE & OPTIMIZATION
# ========================================

# Threading (Memory Optimization)
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1
TORCH_NUM_THREADS=1

# Caching
ENABLE_REDIS_CACHE=false
REDIS_URL=redis://localhost:6379

# Request Limits
MAX_REQUESTS_PER_MINUTE=100
MAX_CONCURRENT_REQUESTS=10

# ========================================
# DEVELOPMENT & DEBUGGING
# ========================================

# Logging Level
LOG_LEVEL=INFO

# Development Features
ENABLE_DEBUG_MODE=false
ENABLE_API_DOCS=true
ENABLE_CORS_ALL_ORIGINS=true

# Testing
ENABLE_TEST_ENDPOINTS=false
TEST_DATA_SIZE=100

# ========================================
# PRODUCTION SETTINGS
# ========================================

# Security
CORS_ORIGINS=["http://localhost:3000", "https://yourdomain.com"]
RATE_LIMITING=true

# Monitoring
ENABLE_METRICS=false
METRICS_ENDPOINT=/metrics

# Backup
AUTO_BACKUP_ENABLED=false
BACKUP_INTERVAL_HOURS=24